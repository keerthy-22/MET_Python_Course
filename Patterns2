
n = 5
for row in range(1,n+1):
     counter = 1 
     for col in range(1,row+1):
         print(counter,end=" ")
         counter += 1
     print()
print("----------------------------")
for row in range(1,6):
     for col in range(1,row+1):
         print(col,end=" ")
     print()
print("----------------------------")
for i in range(1,6):
    for j in range(i,0,-1):
        print(j,end=" ")
    print()
print("----------------------------")
for row in range(5,0,-1):
     for col in range(1,row+1):
         print(col,end=" ")
     print()
print("----------------------------")
num = 1
for row in range(5,0,-1):
     for col in range(row):
         print(num%10,end=" ")
         num += 1
     print()
